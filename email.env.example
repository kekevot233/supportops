# 将以下变量添加到你已有的 .env 文件中。
# 不要将 SMTP_AUTH_CODE 发到聊天、提交到 Git，或写入 Python 代码。

# QQ 邮箱 SMTP 默认配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# 发件账号。可以与收件账号相同。
SMTP_USERNAME=your_qq_number@qq.com
SMTP_AUTH_CODE=your_qq_mail_authorization_code
SMTP_FROM=your_qq_number@qq.com

# 日报收件地址（请在本机真实配置中填写）
DAILY_BRIEF_EMAIL_TO=recipient@example.com
